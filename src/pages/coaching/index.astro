---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const offers = (await getCollection('coaching')).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout title="Coaching" description="Solutions-focused coaching for founders, speakers and therapists.">
  <div class="prose">
    <p class="eyebrow">Coaching</p>
    <h1>Coaching</h1>
    <p class="lead">Solutions-focused coaching that lets people 10× their skills. Choose the path that fits you.</p>
  </div>
  <div class="wrap">
    <div class="card-grid">
      {offers.map((o) => (
        <a class="card" href={`/coaching/${o.id}`}>
          <img class="card-image" src={o.data.thumbnail.src} alt="" loading="lazy" decoding="async" />
          <h3>{o.data.title}</h3>
          {o.data.description && <p>{o.data.description}</p>}
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
