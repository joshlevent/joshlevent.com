---
import { getCollection, render } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import ImageGallery from '../../components/ImageGallery.astro';

export async function getStaticPaths() {
  const pieces = await getCollection('art');
  return pieces.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const meta = [d.year, d.status].filter(Boolean).join(' · ');
---
<PageLayout title={d.title} description={d.description} eyebrow={meta} hero={d.hero} sectionHref="/art" sectionLabel="Art">
  {d.launch && <p><a class="button" href={d.launch.href}>{d.launch.label} →</a></p>}
  <Content />
  <ImageGallery images={d.gallery} layout={d.galleryLayout} label={`${d.title} images`} />
  {d.launch && <p><a class="button" href={d.launch.href}>{d.launch.label} →</a></p>}
  <a class="backlink" href="/art">← All art</a>
</PageLayout>
